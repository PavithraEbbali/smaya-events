# ---------------------------------------------------------------------------
# Smaya Events — environment variables
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Resend (https://resend.com) — required for /api/contact to actually send mail.
# Without this the API route still validates + returns 200 in dev, and logs the
# payload to the server console instead of sending.
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g. "Smaya Events <hello@smayaevents.com>"
CONTACT_FROM_EMAIL=

# Where inquiries land.
CONTACT_TO_EMAIL=

# Absolute site origin, used for metadataBase / OG tags / sitemap.
NEXT_PUBLIC_SITE_URL=https://smayaevents.com
